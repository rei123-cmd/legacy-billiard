{
  "version": 2,
  "functions": {
    "laravel/public/*.php": {
      "runtime": "vercel-php@0.6.2"
    }
  },
  "routes": [
    {
      "src": "/css/(.*)",
      "dest": "/laravel/public/css/$1"
    },
    {
      "src": "/js/(.*)",
      "dest": "/laravel/public/js/$1"
    },
    {
      "src": "/images/(.*)",
      "dest": "/laravel/public/images/$1"
    },
    {
      "src": "/(.*\\.php)",
      "dest": "/laravel/public/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/laravel/public/index.php"
    }
  ]
}